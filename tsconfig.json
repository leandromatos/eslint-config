{
  // Type-checks everything the repository owns, including `eslint.config.mts`. ESLint's
  // type-aware layer resolves a file through the nearest project, so a config file that
  // no project covers fails to parse rather than being linted.
  //
  // This repository's config is also the one place the package consumes itself the way a
  // downstream project does, so a break in the public API surfaces here first.
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "esnext",
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["eslint.config.mts", "src/index.js", "src/import-boundaries.js"]
}
