{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    /*
     * Only what the fixtures read. The DOM library and the Node types are most of what a cold program parses, and the
     * first file the spec lints pays for that program inside its own timeout. The builtin fixture imports for its side
     * effect alone, so it leaves no binding a type-aware rule reads.
     */
    "lib": ["ESNext"],
    "jsx": "react-jsx",
    "types": ["react"],
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "files": [
    "floating-promise.ts",
    "missing-alt.tsx",
    "bare-builtin.ts",
    "swallowed-catch.ts",
    "closed-set.ts",
    "conditional-hook.tsx",
    "multiline-prop-out-of-order.tsx"
  ]
}
