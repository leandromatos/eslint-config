{
  "name": "@leandromatos/eslint-config",
  "version": "3.3.1",
  "description": "ESLint flat configuration with TypeScript, React, import sorting, JSON, and Markdown support.",
  "keywords": [
    "eslint",
    "eslintconfig",
    "eslintplugin",
    "eslint-plugin",
    "config"
  ],
  "license": "MIT",
  "author": "Leandro Matos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandromatos/eslint-config.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "pnpm run clean:build && pnpm run compile",
    "clean:build": "rm -rf dist",
    "compile": "tsc --project tsconfig.build.json",
    "lint": "pnpm run lint:ts && pnpm run lint:format && pnpm run lint:md && pnpm run lint:dead",
    "lint:fix": "pnpm run lint:fix:ts && pnpm run lint:fix:format && pnpm run lint:fix:md",
    "lint:fix:md": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:ts": "tsc --noEmit && eslint .",
    "prepare": "husky",
    "release:production": "./scripts/release/production.sh",
    "release:snapshot": "./scripts/release/snapshot.sh",
    "test": "pnpm run test:js && pnpm run test:sh",
    "test:cov": "vitest run --coverage",
    "test:js": "vitest run",
    "test:sh": "bats --recursive scripts/release/__tests__",
    "test:ui": "vitest --ui",
    "test:watch": "vitest watch",
    "lint:fix:ts": "eslint . --fix",
    "lint:format": "prettier --check .",
    "lint:fix:format": "prettier --write .",
    "lint:dead": "knip"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@typescript-eslint/utils": "^8.70.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsdoc": "^64.5.4",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.70.1"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=5 <7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@12.6.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@leandromatos/commitlint-config": "^1.1.3",
    "@leandromatos/prettier-config": "^2.2.0",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@typescript-eslint/rule-tester": "^8.70.1",
    "@typescript-eslint/typescript-estree": "8.70.1",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "bats": "^1.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "husky": "^9.1.7",
    "knip": "^6.38.0",
    "lint-staged": "^17.5.1",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
