{
  "name": "@leandromatos/eslint-config",
  "version": "3.0.2",
  "description": "ESLint flat configuration with TypeScript, React, import sorting, JSON, and Markdown support.",
  "keywords": [
    "eslint",
    "config"
  ],
  "license": "MIT",
  "author": "Leandro Matos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandromatos/eslint-config.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "!src/__tests__",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "yarn clean:build && yarn compile",
    "clean:build": "rm -f src/index.d.ts",
    "compile": "tsc --project tsconfig.json",
    "lint": "yarn lint:ts && yarn lint:js",
    "lint:ts": "tsc --project tsconfig.json --noEmit",
    "lint:js": "eslint .",
    "lint:fix": "yarn lint:fix:js",
    "lint:fix:js": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:cov": "vitest run --coverage",
    "release:snapshot": "./scripts/release/snapshot.sh",
    "release:production": "./scripts/release/production.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsonc": "^3.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.7.0",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=5 <7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@leandromatos/commitlint-config": "^1.0.1",
    "@leandromatos/prettier-config": "^2.0.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
