{
  "name": "@leandromatos/eslint-config",
  "version": "3.3.1",
  "description": "ESLint flat configuration with TypeScript, React, import sorting, JSON, and Markdown support.",
  "keywords": [
    "eslint",
    "config"
  ],
  "license": "MIT",
  "author": "Leandro Matos",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leandromatos/eslint-config.git"
  },
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
  "files": [
    "src",
    "!src/__tests__",
    "LICENSE"
  ],
  "publishConfig": {
    "provenance": true,
    "access": "public",
    "tag": "latest"
  },
  "scripts": {
    "build": "pnpm run clean:build && pnpm run compile",
    "clean:build": "rm -f src/*.d.ts",
    "compile": "tsc --project tsconfig.build.json && prettier --write --log-level warn 'src/*.d.ts'",
    "lint": "pnpm run lint:ts && pnpm run lint:js && pnpm run lint:md",
    "lint:ts": "tsc --project tsconfig.json",
    "lint:js": "eslint .",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#node_modules\"",
    "lint:fix": "pnpm run lint:fix:js && pnpm run lint:fix:md",
    "lint:fix:js": "eslint . --fix",
    "lint:fix:md": "markdownlint-cli2 --fix \"**/*.md\" \"#node_modules\"",
    "test": "pnpm run test:js && pnpm run test:sh",
    "test:js": "vitest run",
    "test:sh": "bats --recursive scripts/release/__tests__",
    "test:watch": "vitest watch",
    "test:ui": "vitest --ui",
    "test:cov": "vitest run --coverage",
    "release:snapshot": "./scripts/release/snapshot.sh",
    "release:production": "./scripts/release/production.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsonc": "^3.4.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.11.0",
    "typescript-eslint": "^8.67.0"
  },
  "peerDependencies": {
    "eslint": ">=10",
    "typescript": ">=5 <7"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@11.21.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@leandromatos/commitlint-config": "^1.1.1",
    "@leandromatos/prettier-config": "^2.1.1",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "bats": "^1.13.0",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "markdownlint-cli2": "^0.23.2",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
