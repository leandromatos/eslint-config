node_modules/

# Build output
dist/
*.tsbuildinfo

# What a test run writes
coverage/
.vitest/

# What the tools of whoever works here keep, local by definition
.claude/
.DS_Store
.eslintcache
*.log

# Credentials
.npmrc
.env
.env.*

# The package `pnpm pack` writes
*.tgz

# Lockfiles of another package manager: this repository resolves with pnpm, and a second lockfile resolves the same
# ranges to other versions.
yarn.lock
package-lock.json
